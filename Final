@router.post("/age/start")
async def start_age_verification(
    method: str = Form(...),
    document_type: Optional[str] = Form(None),
    current_user = Depends(get_current_user)
):
    """Start age verification process"""
    user_id = str(current_user["_id"])
    
    # Check if already verified
    if current_user.get("verification_status") in ["age_verified", "fully_verified"]:
        return {"message": "Already verified", "status": current_user["verification_status"]}
    
    # Create verification session
    verification_record = {
        "user_id": user_id,
        "method": method,
        "document_type": document_type,
        "status": "pending_upload",
        "started_at": datetime.now(timezone.utc).isoformat(),
        "completed_at": None,
        "result": None,
        "attempts": 1
    }
    
    # Check for existing pending verification
    existing = await verification_collection.find_one({
        "user_id": user_id,
        "status": {"$in": ["pending_upload", "processing"]}
    })
    
    if existing:
        await verification_collection.update_one(
            {"_id": existing["_id"]},
            {"$inc": {"attempts": 1}, "$set": {"method": method}}
        )
        return {
            "message": "Verification already in progress",
            "verification_id": str(existing["_id"]),
            "status": "pending_upload"
        }
    
    result = await verification_collection.insert_one(verification_record)
    
    return {
        "message": "Verification started",
        "verification_id": str(result.inserted_id),
        "method": method,
        "next_step": "upload_documents" if method == "id_document" else "capture_selfie"
    }

@router.post("/upload/{verification_id}")
async def upload_verification_documents(
    verification_id: str,
    id_front: Optional[UploadFile] = File(None),
    id_back: Optional[UploadFile] = File(None),
    selfie: UploadFile = File(...),
    current_user = Depends(get_current_user)
):
    """Upload ID documents and selfie for verification"""
    user_id = str(current_user["_id"])
    
    # Verify ownership
    verification = await verification_collection.find_one({
        "_id": verification_id,
        "user_id": user_id
    })
    
    if not verification:
        raise HTTPException(status_code=404, detail="Verification session not found")
    
    uploaded_urls = {}
    
    # Upload to Cloudinary
    try:
        if id_front:
            front_result = cloudinary.uploader.upload(
                id_front.file,
                folder=f"verifications/{user_id}",
                resource_type="image"
            )
            uploaded_urls["id_front"] = front_result["secure_url"]
        
        if id_back:
            back_result = cloudinary.uploader.upload(
                id_back.file,
                folder=f"verifications/{user_id}",
                resource_type="image"
            )
            uploaded_urls["id_back"] = back_result["secure_url"]
        
        selfie_result = cloudinary.uploader.upload(
            selfie.file,
            folder=f"verifications/{user_id}",
            resource_type="image"
        )
        uploaded_urls["selfie"] = selfie_result["secure_url"]
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Upload failed: {str(e)}")
    
    # Update verification record
    await verification_collection.update_one(
        {"_id": verification_id},
        {
            "$set": {
                "documents": uploaded_urls,
                "status": "processing",
                "submitted_at": datetime.now(timezone.utc).isoformat()
            }
        }
    )
    
    # Process verification
    if verification["method"] == "id_document":
        result = await SafetyService.verify_age_document(
            uploaded_urls.get("id_front"),
            uploaded_urls.get("id_back"),
            uploaded_urls["selfie"]
        )
    else:
        result = await SafetyService.facial_age_estimation(uploaded_urls["selfie"])
    
    # Update verification status
    await verification_collection.update_one(
        {"_id": verification_id},
        {
            "$set": {
                "status": "completed" if result["verified"] else "rejected",
                "result": result,
                "completed_at": datetime.now(timezone.utc).isoformat()
            }
        }
    )
    
    # Update user verification status
    if result["verified"]:
        new_status = "fully_verified" if verification["method"] == "id_document" else "age_verified"
        await users_collection.update_one(
            {"_id": current_user["_id"]},
            {
                "$set": {
                    "verification_status": new_status,
                    "verified_at": datetime.now(timezone.utc).isoformat(),
                    "verification_method": verification["method"]
                }
            }
        )
    
    return {
        "status": "verified" if result["verified"] else "rejected",
        "method": verification["method"],
        "details": result
    }

