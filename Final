@router.get("/conversations")
async def get_conversations(current_user = Depends(get_current_verified_user)):
    """Get user's message conversations"""
    
    user_id = str(current_user["_id"])
    
    pipeline = [
        {
            "$match": {
                "$or": [
                    {"from_user_id": user_id},
                    {"to_user_id": user_id}
                ]
            }
        },
        {"$sort": {"created_at": -1}},
        {
            "$group": {
                "_id": {
                    "$cond": [
                        {"$eq": ["$from_user_id", user_id]},
                        "$to_user_id",
                        "$from_user_id"
                    ]
                },
                "last_message": {"$first": "$$ROOT"},
                "unread_count": {
                    "$sum": {
                        "$cond": [
                            {"$and": [
                                {"$eq": ["$to_user_id", user_id]},
                                {"$eq": ["$read", False]}
                            ]},
                            1,
                            0
                        ]
                    }
                }
            }
        },
        {"$sort": {"last_message.created_at": -1}}
    ]
    
    conversations = await messages_collection.aggregate(pipeline).to_list(length=50)
    
    result = []
    for conv in conversations:
        other_user_id = conv["_id"]
        other_user = await users_collection.find_one({"_id": ObjectId(other_user_id)})
        
        if other_user:
            result.append({
                "user_id": other_user_id,
                "username": other_user["username"],
                "verified": other_user.get("verification_status") in ["age_verified", "fully_verified"],
                "last_message": {
                    "content": conv["last_message"]["content"][:50] + "..." if len(conv["last_message"]["content"]) > 50 else conv["last_message"]["content"],
                    "timestamp": conv["last_message"]["created_at"],
                    "from_me": conv["last_message"]["from_user_id"] == user_id
                },
                "unread_count": conv["unread_count"]
            })
    
    return {"conversations": result}

@router.get("/{user_id}")
async def get_messages(
    user_id: str,
    page: int = 1,
    limit: int = 50,
    current_user = Depends(get_current_verified_user)
):
    """Get message history with specific user"""
    
    my_id = str(current_user["_id"])
    
    # Check if blocked
    if await is_blocked(my_id, user_id):
        raise HTTPException(status_code=403, detail="You have blocked this user")
    
    if await is_blocked(user_id, my_id):
        raise HTTPException(status_code=403, detail="You have been blocked by this user")
    
    query = {
        "$or": [
            {"from_user_id": my_id, "to_user_id": user_id},
            {"from_user_id": user_id, "to_user_id": my_id}
        ]
    }
    
    skip = (page - 1) * limit
    cursor = messages_collection.find(query).sort("created_at", -1).skip(skip).limit(limit)
    messages = await cursor.to_list(length=limit)
    
    # Mark messages as read
    await messages_collection.update_many(
        {"from_user_id": user_id, "to_user_id": my_id, "read": False},
        {"$set": {"read": True}}
    )
    
    return {
        "messages": [
            {
                "id": str(m["_id"]),
                "content": m["content"],
                "from_me": m["from_user_id"] == my_id,
                "timestamp": m["created_at"],
                "read": m.get("read", False)
            }
            for m in reversed(messages)
        ],
        "other_user": await get_user_preview(user_id)
    }

@router.post("/{user_id}")
async def send_message(
    user_id: str,
    content: str,
    ad_id: Optional[int] = None,
    current_user = Depends(get_current_verified_user)
):
    """Send message to user"""
    
    my_id = str(current_user["_id"])
    
    # Check blocks
    if await is_blocked(my_id, user_id):
        raise HTTPException(status_code=403, detail="You have blocked this user")
    
    if await is_blocked(user_id, my_id):
        raise HTTPException(status_code=403, detail="You have been blocked by this user")
    
    # Content safety check
    safety_check = await SafetyService.check_content_safety(content)
    if not safety_check["safe"]:
        raise HTTPException(
            status_code=400, 
            detail=f"Message blocked: {', '.join(safety_check['flags'])}"
        )
    
    # Get recipient info
    recipient = await users_collection.find_one({"_id": ObjectId(user_id)})
    if not recipient:
        raise HTTPException(status_code=404, detail="User not found")
    
    message = {
