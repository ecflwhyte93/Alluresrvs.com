    }

@router.websocket("/ws/{token}")
async def websocket_endpoint(websocket: WebSocket, token: str):
    """WebSocket for real-time messaging"""
    
    await websocket.accept()
    
    # Verify token
    try:
        payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])
        email = payload.get("sub")
        user = await users_collection.find_one({"email": email})
        if not user:
            await websocket.close(code=4001)
            return
        user_id = str(user["_id"])
    except:
        await websocket.close(code=4001)
        return
    
    # Register connection
    active_connections[user_id] = websocket
    
    try:
        while True:
            data = await websocket.receive_json()
            
            if data.get("type") == "ping":
                await websocket.send_json({"type": "pong"})
            
            elif data.get("type") == "typing":
                to_user_id = data.get("to_user_id")
                if to_user_id in active_connections:
                    await active_connections[to_user_id].send_json({
                        "type": "typing",
                        "from_user_id": user_id
                    })
    
    except WebSocketDisconnect:
        if user_id in active_connections:
            del active_connections[user_id]
    except Exception:
        if user_id in active_connections:
            del active_connections[user_id]

# Helper functions
async def is_blocked(user_id: str, blocked_user_id: str) -> bool:
    user = await users_collection.find_one({"_id": ObjectId(user_id)})
    if user:
        return blocked_user_id in user.get("blocked_users", [])
    return False

async def get_user_preview(user_id: str) -> dict:
    user = await users_collection.find_one({"_id": ObjectId(user_id)})
    if user:
        return {
            "id": user_id,
            "username": user["username"],
            "verified": user.get("verification_status") in ["age_verified", "fully_verified"],
            "photo": user.get("profile_photo")
        }
    return {"id": user_id, "username": "Unknown"}
