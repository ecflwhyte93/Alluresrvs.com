@router.post("/register", response_model=Token)
async def register(data: UserCreate, background_tasks: BackgroundTasks):
    """Register new user with initial age check (self-declaration)"""
    # Check existing
    if await users_collection.find_one({"email": data.email}):
        raise HTTPException(status_code=400, detail="Email already registered")
    if await users_collection.find_one({"username": data.username}):
        raise HTTPException(status_code=400, detail="Username already taken")
    
    # Calculate age
    birth_date = datetime.strptime(data.date_of_birth, "%Y-%m-%d")
    age = int((datetime.now() - birth_date).days / 365.25)
    
    user_dict = {
        "email": data.email,
        "username": data.username,
        "full_name": data.full_name,
        "password_hash": hash_password(data.password),
        "date_of_birth": data.date_of_birth,
        "age": age,
        "phone_number": data.phone_number,
        "role": "user",
        "is_vip": False,
        "verification_status": "unverified",
        "created_at": datetime.now(timezone.utc).isoformat(),
        "last_login": None,
        "profile_photo": None,
        "bio": None,
        "location": None,
        "safety_score": 100,
        "email_verified": False,
        "phone_verified": False if data.phone_number else None,
        "total_ads": 0,
        "active_ads": 0,
        "is_active": True,
        "warning_count": 0
    }
    
    await users_collection.insert_one(user_dict)
    
    # Log registration for safety audit
    await SafetyService.create_safety_report(
        str(user_dict.get("_id")), 
        "registration", 
        {"ip": "logged", "age_declared": age}
    )
    
    access_token = create_access_token(data={"sub": data.email})
    return {"access_token": access_token, "token_type": "bearer"}

@router.post("/login", response_model=Token)
async def login(data: UserLogin):
    """Authenticate user"""
    user = await users_collection.find_one({"email": data.email})
    if not user or not verify_password(data.password, user["password_hash"]):
        raise HTTPException(status_code=401, detail="Invalid email or password")
    
    if not user.get("is_active", True):
        raise HTTPException(status_code=403, detail="Account suspended. Contact support.")
    
    # Update last login
    await users_collection.update_one(
        {"email": data.email},
        {"$set": {"last_login": datetime.now(timezone.utc).isoformat()}}
    )
    
    access_token = create_access_token(data={"sub": user["email"]})
    return {"access_token": access_token, "token_type": "bearer"}

