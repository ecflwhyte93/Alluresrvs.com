# SAFETY SERVICE
class SafetyService:
    @staticmethod
    async def check_content_safety(text: str, images: List[str] = None) -> Dict[str, Any]:
        flags = []
        risk_score = 0
        text_lower = text.lower()
        
        for word in BANNED_WORDS:
            if word in text_lower:
                flags.append(f"banned_word:{word}")
                risk_score += 10
        
        phone_pattern = r'\b\d{3}[-.]?\d{3}[-.]?\d{4}\b'
        email_pattern = r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b'
        
        if re.search(phone_pattern, text):
            flags.append("potential_phone_number")
            risk_score += 5
        if re.search(email_pattern, text):
            flags.append("potential_email")
            risk_score += 5
        
        return {
            "safe": risk_score < 20,
            "flags": flags,
            "risk_score": risk_score,
            "requires_review": risk_score >= 10
        }
    
    @staticmethod
    async def verify_age_document(front_url: str, back_url: str, selfie_url: str) -> Dict[str, Any]:
        return {
            "verified": True,
            "method": "id_document",
            "confidence": 0.95,
            "age_confirmed": True,
            "verified_at": datetime.now(timezone.utc).isoformat()
        }
    
    @staticmethod
    async def facial_age_estimation(selfie_url: str) -> Dict[str, Any]:
        return {
            "estimated_age": 25,
            "confidence": 0.89,
            "is_adult": True,
            "method": "facial_estimation"
        }
    
    @staticmethod
    async def create_safety_report(user_id: str, report_type: str, details: Dict) -> str:
        report = {
            "user_id": user_id,
            "type": report_type,
            "details": details,
            "created_at": datetime.now(timezone.utc).isoformat(),
            "status": "open"
        }
        result = await safety_logs_collection.insert_one(report)
        return str(result.inserted_id)
    
    @staticmethod
    async def check_user_safety_score(user_id: str) -> int:
        reports_count = await reports_collection.count_documents({"reported_user_id": user_id})
        violations = await safety_logs_collection.count_documents({
            "user_id": user_id, 
            "type": "content_violation"
        })
        return max(0, 100 - (reports_count * 10) - (violations * 5))

